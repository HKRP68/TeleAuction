# Optional: Telegram bot token from @BotFather. Leave empty to run the Draft Desk only.
BOT_TOKEN=

# Required only when BOT_TOKEN is configured: numeric Telegram owner/super-admin ID.
SUPER_ADMIN_ID=

# Optional: leave empty for long polling. Set to your public app URL for webhook mode.
# Example: https://your-app.onrender.com
WEBHOOK_URL=

# Optional: port used by Flask health/webhook endpoints in webhook mode.
PORT=8080

# Optional: SQLite database location. Use a mounted volume/path in production.
DATABASE_PATH=auction.db

# Optional: private Telegram channel/group ID where the bot can pin DB backups.
# Example: -1001234567890
STATE_CHANNEL_ID=0

# The Draft Desk is available at /draft without a token.
